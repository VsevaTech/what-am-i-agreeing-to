# Copy to .env and fill in. Never commit .env.

# Google Gemini Developer API key (https://aistudio.google.com/apikey). Free tier is enough.
GEMINI_API_KEY=

# Any Gemini Flash model available through the Gemini Developer API.
GEMINI_MODEL=gemini-2.5-flash

# Optional tuning
# AI_TIMEOUT_SECONDS=60
# MAX_UPLOAD_MB=10
# MAX_PAGES=60
# RESULT_TTL_SECONDS=1800
